# PrepPilot - environment for docker-compose.yml (production-style stack)
# Copy to .env in the repo root and replace every CHANGE_ME value.
# .env is git- and docker-ignored. Never commit real secrets.

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=preppilot
POSTGRES_USER=preppilot
# REQUIRED. Used in DATABASE_URL, so avoid URL-reserved characters (@ : / ? # %)
# or URL-encode them. e.g. openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Auth & encryption (REQUIRED) ---------------------------------------------
# >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_secret_of_at_least_32_chars
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: rotating it makes users' stored API keys unreadable.
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_0000000000000000000000000000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- AI -----------------------------------------------------------------------
# Optional server-wide key; users can add their own key in Settings instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MOCK=false
AI_RATE_LIMIT_PER_HOUR=60
WORKER_CONCURRENCY=2

# --- HTTP ---------------------------------------------------------------------
# Comma-separated extra browser origins (e.g. Expo web). The web app is same-origin.
CORS_ORIGINS=
# Number of reverse proxies in front of the API.
TRUST_PROXY=1
LOG_LEVEL=info

# Host ports
API_PORT=4000
WEB_PORT=3000

# Internal URL the web container uses to reach the API. Baked into the web
# image at build time (Next.js rewrites) - rebuild `web` after changing it.
WEB_API_URL=http://api:4000

# Optional image names (e.g. when pushing to a registry)
# API_IMAGE=ghcr.io/your-org/preppilot-api:latest
# WEB_IMAGE=ghcr.io/your-org/preppilot-web:latest
