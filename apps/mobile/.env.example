# Copy to .env and adjust. Inlined at bundle time (restart `expo start` after changing).
#
# Real device (Expo Go / dev build): use your computer's LAN IP, NOT localhost.
#   Windows: ipconfig  |  macOS: ipconfig getifaddr en0  |  Linux: hostname -I
# Android emulator: http://10.0.2.2:4000/api/v1
# iOS simulator / web: http://localhost:4000/api/v1
#
# If unset, the app falls back to 10.0.2.2 on the Android emulator, the Metro host IP on a
# physical device in development, and localhost otherwise.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
